# Sao chép file này thành .env trên VPS (không commit .env thật vào git)

# Bắt buộc: connection string Neon Postgres (lấy từ Neon dashboard > Connection Details)
DATABASE_URL=postgresql://user:password@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Cổng nội bộ Node server lắng nghe (Nginx sẽ proxy vào cổng này)
PORT=3001

# Bot Telegram Cảnh Báo Sự Cố Dành Riêng Cho Developer (Tùy chọn)
DEV_ALERT_TELEGRAM_TOKEN=
DEV_ALERT_TELEGRAM_CHAT_ID=
